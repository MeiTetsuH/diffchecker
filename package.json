{
	"name": "diffchecker",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint && npm run test && npm run build",
		"verify": "npm run check",
		"deploy": "npm run build && wrangler pages deploy out --project-name=diffchecker",
		"preview": "npm run build && wrangler pages dev out"
	},
	"dependencies": {
		"diff": "^8.0.2",
		"lucide-react": "^0.523.0",
		"next": "^16.4.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@next/eslint-plugin-next": "^16.4.2",
		"@types/node": "^20.19.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.2",
		"fake-indexeddb": "^6.2.5",
		"typescript": "^5",
		"vitest": "^4.1.12",
		"wrangler": "^4.152.0"
	},
	"browserslist": [
		"chrome 111",
		"edge 111",
		"firefox 111",
		"safari 16.4",
		"ios_saf 16.4"
	],
	"engines": {
		"node": "^22.23.4 || ^24.22.1 || ^26.12.1"
	},
	"overrides": {
		"miniflare": {
			"undici": "^7.30.1"
		}
	}
}
