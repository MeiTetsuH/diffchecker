{
	"name": "diffchecker",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm run lint && npm run build",
		"verify": "npm run check",
		"deploy": "npm run build && wrangler pages deploy out --project-name=diffchecker",
		"preview": "npm run build && wrangler pages dev out"
	},
