		"lucide-react": "^0.523.0",
		"next": "^16.3.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@next/eslint-plugin-next": "^16.3.2",
		"@types/node": "^20.19.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.2",
		"typescript": "^5",
		"wrangler": "^4.125.0"
	},
	"browserslist": [
		"chrome 111",
		"edge 111",
		"firefox 111",
